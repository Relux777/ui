{
  "name": "ui",
  "version": "0.3.7",
  "description": "RenDit UI — свой UI-фреймворк: стили RenDit SCSS, движок классов RenDit Code и компоненты",
  "private": true,
  "scripts": {
    "dev": "node rendit-code/cli.mjs dev",
    "build": "node rendit-code/cli.mjs build && next build",
    "start": "next start",
    "rendit-code": "node rendit-code/cli.mjs build",
    "rendit-code:watch": "node rendit-code/cli.mjs watch",
    "rendit-code:test": "node rendit-code/test.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" && node rendit-code/test.mjs",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/**/*.test.mjs\"",
    "lint": "biome check",
    "format": "biome format --write",
    "rendit-code:vscode": "node rendit-code/vscode/install.mjs",
    "dist": "node rendit-code/dist.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@boxicons/react": "^1.0.3",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vscode/vsce": "^4.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "^5"
  }
}
